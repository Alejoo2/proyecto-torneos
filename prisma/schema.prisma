// Este es el datasource que ya trae el T3, apuntando a tu DATABASE_URL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SISTEMA 1: AUTH & RBAC
// ==========================================

// --- NextAuth.js Models (Estándar) ---
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Usuario y Perfil ---
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  accounts Account[]
  sessions Session[]
  profile  Profile?

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  postponedMatches        Match[]                  @relation("PostponedMatches")
  markedAbsences          MatchCallUp[]            @relation("MarkedAbsences")
  loadedResults           MatchResult[]            @relation("LoadedResults")
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String?
  phone       String?
  bio         String?   @db.Text
  birthDate   DateTime?
  onboarded   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  player          Player?
  manager         Manager?
}

// --- RBAC: Matriz de Permisos ---
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  assignments RoleAssignment[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleAssignment {
  id         String   @id @default(cuid())
  profileId  String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleId])
}

// --- Datos Específicos por Tipo de Usuario ---
model Player {
  id        String   @id @default(cuid())
  profileId String   @unique
  createdAt DateTime @default(now())

  profile        Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  availabilities PlayerAvailability[]

  teamMemberships TeamMembership[]
  invitations     TeamInvitation[]
  sentInvitations TeamInvitation[] @relation("SentInvitations")

  matchCallUps MatchCallUp[]
  matchStats   MatchPlayerStat[]
  stats        PlayerStats?
}

model PlayerAvailability {
  id        String             @id @default(cuid())
  playerId  String
  dayOfWeek Int
  timeSlot  Int
  status    AvailabilityStatus @default(AVAILABLE)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, dayOfWeek, timeSlot])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

model Manager {
  id        String   @id @default(cuid())
  profileId String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tournaments Tournament[]
}

model Team {
  id              String               @id @default(cuid())
  name            String               @unique
  abbreviation    String               @unique @db.VarChar(10)
  primaryColor    String               @db.VarChar(7)
  secondaryColor  String?              @db.VarChar(7)
  description     String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  status          TeamStatus           @default(DRAFT)
  deletionRequest TeamDeletionRequest?

  memberships        TeamMembership[]
  invitations        TeamInvitation[]
  captaincyTransfers CaptaincyTransfer[]
  enrollments        TournamentEnrollment[]

  homeMatches         Match[]              @relation("HomeMatches")
  awayMatches         Match[]              @relation("AwayMatches")
  walkoverMatches     Match[]              @relation("WalkoverMatches")
  wonMatches          MatchResult[]        @relation("WonMatches")
  matchCallUps        MatchCallUp[]
  matchPlayerStats    MatchPlayerStat[]
  stats               TeamStats?
  tournamentStandings TournamentStanding[]
}

enum TeamStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model TeamMembership {
  id        String    @id @default(cuid())
  playerId  String
  teamId    String
  isCaptain Boolean   @default(false)
  isStarter Boolean   @default(false)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  incomingTransfers CaptaincyTransfer[] @relation("IncomingTransfer")
  outgoingTransfers CaptaincyTransfer[] @relation("OutgoingTransfer")

  @@unique([playerId, teamId])
  @@index([teamId, leftAt])
  @@index([playerId, leftAt])
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String?
  playerId    String
  invitedBy   String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  team    Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player  Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  inviter Player @relation("SentInvitations", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([playerId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

model CaptaincyTransfer {
  id          String                  @id @default(cuid())
  teamId      String
  fromId      String
  toId        String
  status      CaptaincyTransferStatus @default(PENDING)
  requestedAt DateTime                @default(now())
  respondedAt DateTime?

  team Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  from TeamMembership @relation("OutgoingTransfer", fields: [fromId], references: [id], onDelete: Cascade)
  to   TeamMembership @relation("IncomingTransfer", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, status])
}

enum CaptaincyTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model TeamDeletionRequest {
  id          String         @id @default(cuid())
  teamId      String         @unique
  requestedBy String
  createdAt   DateTime       @default(now())
  status      DeletionStatus @default(PENDING)

  team  Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  votes TeamDeletionVote[]

  @@index([teamId, status])
}

enum DeletionStatus {
  PENDING
  APPROVED
  CANCELLED
  EXECUTED
}

model TeamDeletionVote {
  id        String   @id @default(cuid())
  requestId String
  playerId  String
  approve   Boolean  @default(true)
  votedAt   DateTime @default(now())

  request TeamDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, playerId])
}

// ==========================================
// SISTEMA 5: CANCHAS / SEDES
// ==========================================

model Court {
  id          String      @id @default(cuid())
  name        String      @unique
  address     String
  description String?     @db.Text
  inventory   String?     @db.Text
  status      CourtStatus @default(ENABLED)
  lat         Float       @default(0) // ← debe estar
  lon         Float       @default(0) // ← debe estar
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  availability CourtAvailability[]
  tournaments  Tournament[]
  matches      Match[]
}

enum CourtStatus {
  ENABLED
  DISABLED
}

model CourtAvailability {
  id       String                  @id @default(cuid())
  courtId  String
  date     DateTime                @db.Date
  timeSlot Int
  status   CourtAvailabilityStatus @default(AVAILABLE)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, date, timeSlot])
  @@index([courtId, date])
}

enum CourtAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

// ==========================================
// SISTEMA 6: TORNEOS
// ==========================================

model Tournament {
  id                 String           @id @default(cuid())
  name               String
  description        String?          @db.Text
  courtId            String
  managerId          String
  status             TournamentStatus @default(DRAFT)
  format             TournamentFormat @default(SINGLE_ELIMINATION)
  maxTeams           Int
  type               TournamentType   @default(PUBLIC)
  startDate          DateTime?
  enrollmentDeadline DateTime
  dayOfWeek          Int
  timeSlot           Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  court       Court                  @relation(fields: [courtId], references: [id], onDelete: Restrict)
  manager     Manager                @relation(fields: [managerId], references: [id], onDelete: Restrict)
  enrollments TournamentEnrollment[]
  phases      TournamentPhase[]
  slotHolds   TournamentSlotHold[]
  matches     Match[]
  standings   TournamentStanding[]

  @@index([status, enrollmentDeadline])
  @@index([courtId, status])
}

enum TournamentStatus {
  DRAFT
  SCHEDULED
  GRACE_PERIOD
  IN_PROGRESS
  FINISHED
  CANCELLED
  SUSPENDED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  LEAGUE
  LEAGUE_PLUS_ELIMINATION
}

enum TournamentType {
  PUBLIC
  PRIVATE
}

model TournamentEnrollment {
  id                String           @id @default(cuid())
  tournamentId      String
  teamId            String
  status            EnrollmentStatus @default(PENDING_AVAILABILITY)
  availabilityNote  String?          @db.Text
  enrolledAt        DateTime         @default(now())
  approvedAt        DateTime?
  approvedBy        String?
  disapprovedAt     DateTime?
  disapprovedBy     String?
  disapprovedReason String?          @db.Text

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([tournamentId, status])
  @@index([teamId, status])
}

enum EnrollmentStatus {
  PENDING_AVAILABILITY
  PENDING_PAYMENT
  APPROVED
  REJECTED
  DISAPPROVED
}

model TournamentPhase {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  order        Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@index([tournamentId, order])
}

model TournamentSlotHold {
  id           String   @id @default(cuid())
  tournamentId String
  heldBy       String // PlayerId del capitán
  teamId       String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, expiresAt])
  @@index([heldBy])
}

// ==========================================
// SISTEMA 7: PARTIDOS Y APLAZAMIENTOS
// ==========================================

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  POSTPONED
  CANCELLED
  WALKOVER
}

model Referee {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
}

model Match {
  id              String      @id @default(cuid())
  tournamentId    String
  phaseId         String
  homeTeamId      String?
  awayTeamId      String?
  courtId         String?
  scheduledAt     DateTime?
  date            DateTime?   @db.Date // Para matchear con CourtAvailability
  timeSlot        Int?
  status          MatchStatus @default(SCHEDULED)
  postponedReason String?     @db.Text
  postponedAt     DateTime?
  postponedBy     String?
  walkoverTeamId  String?
  refereeId       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  phase           TournamentPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  homeTeam        Team?           @relation("HomeMatches", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam        Team?           @relation("AwayMatches", fields: [awayTeamId], references: [id], onDelete: SetNull)
  walkoverTeam    Team?           @relation("WalkoverMatches", fields: [walkoverTeamId], references: [id], onDelete: SetNull)
  court           Court?          @relation(fields: [courtId], references: [id], onDelete: SetNull)
  referee         Referee?        @relation(fields: [refereeId], references: [id], onDelete: SetNull)
  postponedByUser User?           @relation("PostponedMatches", fields: [postponedBy], references: [id], onDelete: SetNull)

  callUps     MatchCallUp[]
  result      MatchResult?
  playerStats MatchPlayerStat[]

  @@index([tournamentId, phaseId])
  @@index([status])
  @@index([courtId, date, timeSlot])
}

model MatchCallUp {
  id       String    @id @default(cuid())
  matchId  String
  teamId   String
  playerId String
  isAbsent Boolean   @default(false)
  markedBy String?
  markedAt DateTime?
  notes    String?   @db.Text

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  marker User?  @relation("MarkedAbsences", fields: [markedBy], references: [id], onDelete: SetNull)

  @@unique([matchId, teamId, playerId])
  @@index([matchId, teamId])
}

model MatchResult {
  id            String   @id @default(cuid())
  matchId       String   @unique
  homeScore     Int
  awayScore     Int
  winnerId      String?
  isWalkover    Boolean  @default(false)
  notes         String?  @db.Text
  externalLinks String?  @db.Text
  loadedAt      DateTime @default(now())
  loadedBy      String

  match        Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winner       Team? @relation("WonMatches", fields: [winnerId], references: [id], onDelete: SetNull)
  loadedByUser User  @relation("LoadedResults", fields: [loadedBy], references: [id], onDelete: Restrict)
}

model MatchPlayerStat {
  id          String @id @default(cuid())
  matchId     String
  playerId    String
  teamId      String
  goals       Int    @default(0)
  blueCards   Int    @default(0)
  yellowCards Int    @default(0)
  redCards    Int    @default(0)
  fouls       Int    @default(0)
  ownGoals    Int    @default(0)

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([matchId, teamId])
}

// ==========================================
// SISTEMA 10: ESTADÍSTICAS AGREGADAS
// ==========================================

model PlayerStats {
  id                     String   @id @default(cuid())
  playerId               String   @unique
  matchesWithStats       Int      @default(0)
  totalGoals             Int      @default(0)
  avgGoalsLast10         Float    @default(0)
  totalBlueCardsLast10   Int      @default(0)
  totalYellowCardsLast10 Int      @default(0)
  totalRedCardsLast10    Int      @default(0)
  totalFoulsLast10       Int      @default(0)
  fairPlayScore          Float    @default(0)
  lastCalculatedAt       DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model TeamStats {
  id               String   @id @default(cuid())
  teamId           String   @unique
  matchesPlayed    Int      @default(0)
  matchesWon       Int      @default(0)
  matchesDrawn     Int      @default(0)
  matchesLost      Int      @default(0)
  goalsFor         Int      @default(0)
  goalsAgainst     Int      @default(0)
  goalDifference   Int      @default(0)
  fairPlayScore    Float    @default(0)
  lastCalculatedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model TournamentStanding {
  id             String   @id @default(cuid())
  tournamentId   String
  teamId         String
  position       Int      @default(0)
  matchesPlayed  Int      @default(0)
  matchesWon     Int      @default(0)
  matchesDrawn   Int      @default(0)
  matchesLost    Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  points         Int      @default(0)
  fairPlayScore  Float    @default(0)
  updatedAt      DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([tournamentId, position])
}

// ==========================================
// SISTEMA 11: NOTIFICACIONES IN-APP
// ==========================================

enum NotificationFamily {
  AUTH
  TEAM
  RECRUITMENT
  TOURNAMENT
  MATCH
  COURT
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum NotificationType {
  // Auth
  // Team
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  MEMBERSHIP_JOINED
  TEAM_DELETE_REQUESTED
  // Recruitment
  RECRUITMENT_REQUEST_SENT
  RECRUITMENT_REQUEST_ACCEPTED
  // Tournament
  TOURNAMENT_PUBLISHED
  ENROLLMENT_SUBMITTED
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  TOURNAMENT_CLOSED_AND_DRAWN
  // Match
  MATCH_SCHEDULED
  MATCH_POSTPONED
  MATCH_RESCHEDULED
  MATCH_RESULT_LOADED
  // Court
  COURT_DISABLED
}

model Notification {
  id          String             @id @default(cuid())
  userId      String
  family      NotificationFamily
  type        NotificationType
  title       String
  body        String             @db.Text
  payload     Json?
  status      NotificationStatus @default(UNREAD)
  actionTaken String?
  createdAt   DateTime           @default(now())
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, family])
}

model NotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  family    NotificationFamily
  isEnabled Boolean            @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, family])
}
